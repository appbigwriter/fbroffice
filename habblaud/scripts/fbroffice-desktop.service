[Unit]
Description=FBR Office private browser desktop
After=network.target

[Service]
User=fbroffice-browser
Group=fbroffice-browser
Environment=HOME=/var/lib/fbroffice-browser
ExecStart=/usr/bin/tigervncserver :9 -fg -localhost yes -geometry 1440x900 -depth 24 -rfbport 5909 -SecurityTypes VncAuth -PasswordFile /var/lib/fbroffice-browser/.vnc/passwd -xstartup /opt/fbroffice-browser/session.sh
Restart=always
RestartSec=3
KillMode=control-group
TimeoutStopSec=10
MemoryMax=1536M
CPUQuota=150%
TasksMax=1024
UMask=0077

[Install]
WantedBy=multi-user.target
